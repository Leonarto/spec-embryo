+// COPY-ONLY exploratory instrumentation. Never integrate this module into product.
+import {AsyncLocalStorage} from 'node:async_hooks';
+import {appendFileSync} from 'node:fs';
+import {performance,PerformanceObserver} from 'node:perf_hooks';
+const detailed=process.env.SPM_DETAIL_DIAGNOSTIC_MODE==='spans';
+const output=process.env.SPM_DETAIL_DIAGNOSTIC_LOG??'/private/tmp/spm-task138-diagnostic-events.jsonl';
+interface Sample {event:string;id:number;url:string;start:number;end?:number;mode:string;calls:Record<string,number>;syncMs:Record<string,number>;syncMax:Record<string,{ms:number;path?:string}>;asyncWallMs:Record<string,number>;docs:number;bytes:number;frontmatterBytes:number;readCalls:number;queueWaitMs:number;callbackWallMs:number;active:number;peak:number;collections:Record<string,number>;error?:string}
+const storage=new AsyncLocalStorage<Sample>();let sequence=0;
+const write=(value:unknown)=>appendFileSync(output,JSON.stringify(value)+'\n');
+write({event:'startup',mode:detailed?'spans':'counts',pid:process.pid,runtime:process.version,timeOrigin:performance.timeOrigin});
+if(detailed){const observer=new PerformanceObserver(list=>{for(const entry of list.getEntries())write({event:'gc',pid:process.pid,start:entry.startTime,duration:entry.duration,detail:(entry as unknown as {detail:unknown}).detail});});observer.observe({entryTypes:['gc']});}
+const add=(target:Record<string,number>,name:string,value=1)=>target[name]=(target[name]??0)+value;
+export function diagSync<T>(name:string,work:()=>T,path?:string):T {const sample=storage.getStore();if(!sample||!detailed)return work();const start=performance.now();add(sample.calls,name);try{return work();}finally{const ms=performance.now()-start;add(sample.syncMs,name,ms);if(!sample.syncMax[name]||ms>sample.syncMax[name]!.ms)sample.syncMax[name]={ms,path};}}
+export async function diagAsync<T>(name:string,work:()=>Promise<T>):Promise<T>{const sample=storage.getStore();if(!sample||!detailed&&name!=='context')return work();const start=performance.now();add(sample.calls,name);try{return await work();}finally{add(sample.asyncWallMs,name,performance.now()-start);}}
+export function diagQueued(){return detailed?performance.now():0;}
+export function diagReadStart(queued:number){const sample=storage.getStore();if(!sample||!detailed)return 0;sample.active++;sample.peak=Math.max(sample.peak,sample.active);sample.queueWaitMs+=performance.now()-queued;sample.readCalls++;return performance.now();}
+export function diagReadEnd(start:number,bytes?:Buffer){const sample=storage.getStore();if(!sample||!detailed)return;sample.active--;sample.callbackWallMs+=performance.now()-start;if(bytes)sample.bytes+=bytes.length;}
+export function diagDocument(path:string,bytes:Buffer){const sample=storage.getStore();if(!sample||!detailed)return;sample.docs++;const end=bytes.indexOf('\n+++',4);if(end>=0)sample.frontmatterBytes+=end-4;const group=/\/(tasks|specs|handoffs|session|org)\//.exec(path)?.[1]??'current';add(sample.collections,group);}
+export async function diagnosticRequest(url:string,work:()=>Promise<Response>):Promise<Response>{
+ const sample:Sample={event:'request',id:++sequence,url,start:performance.now(),mode:detailed?'spans':'counts',calls:{},syncMs:{},syncMax:{},asyncWallMs:{},docs:0,bytes:0,frontmatterBytes:0,readCalls:0,queueWaitMs:0,callbackWallMs:0,active:0,peak:0,collections:{}};
+ const cpu=process.cpuUsage(),elu=performance.eventLoopUtilization();
+ return storage.run(sample,async()=>{try{const response=await work();response.headers.set('x-spm-diagnostic-request',String(sample.id));return response;}catch(error){sample.error=String(error);throw error;}finally{sample.end=performance.now();write({...sample,pid:process.pid,elapsedMs:sample.end-sample.start,cpu:process.cpuUsage(cpu),elu:performance.eventLoopUtilization(elu)});}});
+}
