    "test": "bun test",
    "check:agents": "bun run scripts/check-agents.ts",
    "web:check": "bun run --cwd web check"
  },
  "dependencies": {
    "@lucide/svelte": "^1.7.0",
    "@sveltejs/adapter-auto": "7.0.1",
    "@sveltejs/kit": "2.55.0",
