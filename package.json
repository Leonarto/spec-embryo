{
  "name": "spec-embryo",
  "version": "0.1.0",
  "description": "Spec Embryo: local-first, spec-first, CLI-first project memory and orchestration for AI-assisted software work.",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "spec-embryo": "src/index.ts",
    "spm": "src/index.ts"
